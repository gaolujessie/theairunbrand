---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Notes" description="Weekly notes and case studies on running a consumer brand with an AI team: the job, the old way, the AI way, what it cost, what broke, what you can copy.">
  <section class="intro">
    <div class="wrap grid-12">
      <div class="span-8 stack">
        <p class="eyebrow">Notes</p>
        <h1 class="h-display">What I actually did this week, with AI, in a real brand.</h1>
        <p class="lede">Operating notes, not thought leadership. Each one follows the same shape: the job, the old way, the AI way, what it cost, what broke, what you can copy. <a href="/#subscribe">Get them by email</a> or <a href="/rss.xml">subscribe by RSS</a>.</p>
      </div>
    </div>
  </section>
  <section class="wrap list">
    {notes.map(n => (
      <article class="row reveal">
        <div class="row__meta">
          <p class="eyebrow eyebrow--support">{n.data.kind === 'case-study' ? 'Case study' : 'Note'}{n.data.tag ? ` · ${n.data.tag}` : ''}</p>
          <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
        </div>
        <div class="row__body">
          <h2 class="h-card"><a href={`/notes/${n.id}`}>{n.data.title}</a></h2>
          <p>{n.data.description}</p>
          <a href={`/notes/${n.id}`} class="link">Read →</a>
        </div>
      </article>
    ))}
    {notes.length === 0 && <p class="lede">First note coming shortly.</p>}
  </section>
</Base>
<style>
  .intro { padding-block: clamp(56px, 7vw, 96px) clamp(40px, 5vw, 64px); }
  .intro .stack { gap: 24px; }
  .list { padding-bottom: clamp(72px, 8vw, 112px); display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 32px; padding: 32px 0; border-top: 1px solid var(--rule); }
  .row__meta { display: flex; flex-direction: column; gap: 8px; font-size: 14px; color: var(--muted); }
  .row__body { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }
  .row__body h2 a { color: var(--ink); }
  .row__body h2 a:hover { color: var(--hero); }
  .row__body p { color: var(--body); font-size: 16px; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 12px; } }
</style>
