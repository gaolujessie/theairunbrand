---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap" style="padding-block: 96px 128px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start">
    <p class="eyebrow">404</p>
    <h1 class="h-display">That page isn’t here.</h1>
    <p class="lede">It may have moved, or never existed. The home page has everything.</p>
    <a href="/" class="btn btn--ink">Back home</a>
  </section>
</Base>
